# ─── Copy this to apps/api/.env and fill in values ───────

# Database
DATABASE_URL=postgresql+asyncpg://cco:cco_dev_pass@localhost:5432/checkincheckout
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development   # development | staging | production

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET_KEY=change_me_to_another_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption (AES-256 for passport data)
ENCRYPTION_KEY=change_me_32_bytes_hex_string_here

# Anthropic
ANTHROPIC_API_KEY=

# Amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com   # use test for dev

# Kaspi Pay
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram
DEEPGRAM_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# AWS (Polly for phone TTS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# Firebase (Push notifications)
FIREBASE_SERVICE_ACCOUNT=   # path to service account JSON or JSON string

# Resend (Email)
RESEND_API_KEY=

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=checkincheckout
CLOUDFLARE_R2_ENDPOINT=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
